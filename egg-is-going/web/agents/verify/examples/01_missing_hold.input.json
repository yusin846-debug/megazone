  "segments": [
    {
      "segment_id": "seg_01",
      "start_ms": 5000,
      "end_ms": 12000,
      "speaker": "p1",
      "text": "3회차 오프닝부터 정리할게요.",
      "uncertain": false
    },
    {
      "segment_id": "seg_02",
      "start_ms": 12000,
      "end_ms": 31000,
      "speaker": "p4",
      "text": "오프닝은 야외에서 가죠. 한강 공원 어때요?",
      "uncertain": false
    },
    {
      "segment_id": "seg_03",
      "start_ms": 31000,
      "end_ms": 48000,
      "speaker": "p2",
      "text": "그날 오후에 비 소식 있던데요.",
      "uncertain": false
    },
    {
      "segment_id": "seg_04",
      "start_ms": 48000,
      "end_ms": 51000,
      "speaker": "p1",
      "text": "우천이면 리스크 크니까 실내로 돌리죠.",
      "uncertain": false
    },
    {
      "segment_id": "seg_05",
      "start_ms": 51000,
      "end_ms": 65000,
      "speaker": "p4",
      "text": "그럼 스튜디오에서 오프닝 찍는 걸로 정리합시다.",
      "uncertain": false
    },
    {
      "segment_id": "seg_06",
      "start_ms": 65000,
      "end_ms": 72000,
      "speaker": "p4",
      "text": "드론 촬영은 예산 때문에 이번엔 빼죠.",
      "uncertain": false
    },
    {
      "segment_id": "seg_07",
      "start_ms": 72000,
      "end_ms": 80000,
      "speaker": "p1",
      "text": "네, 드론은 빼는 걸로 하죠.",
      "uncertain": false
    },
    {
      "segment_id": "seg_08",
      "start_ms": 80000,
      "end_ms": 100000,
      "speaker": "p5",
      "text": "스튜디오 대관은 제가 확인해 볼게요.",
      "uncertain": false
    },
    {
      "segment_id": "seg_09",
      "start_ms": 100000,
      "end_ms": 112000,
      "speaker": "p2",
      "text": "오프닝 멘트는 밝은 여행 브이로그 톤 어때요?",
      "uncertain": false
    },
    {
      "segment_id": "seg_10",
      "start_ms": 112000,
      "end_ms": 125000,
      "speaker": "p1",
      "text": "좋아요, 브이로그 톤으로 가죠.",
      "uncertain": false
    },
    {
      "segment_id": "seg_11",
      "start_ms": 125000,
      "end_ms": 194000,
      "speaker": null,
      "text": "그 부분은... (겹침) 다시 얘기하는 걸로",
      "uncertain": true
    },
    {
      "segment_id": "seg_12",
      "start_ms": 194000,
      "end_ms": 200000,
      "speaker": "p4",
      "text": "게스트 후보 두 명 중에 누구로 갈까요?",
      "uncertain": false
    },
    {
      "segment_id": "seg_13",
      "start_ms": 200000,
      "end_ms": 221000,
      "speaker": "p1",
      "text": "게스트는 일단 출연료 보고 다음 주에 다시 얘기해요.",
      "uncertain": false
    },
    {
      "segment_id": "seg_14",
      "start_ms": 221000,
      "end_ms": 230000,
      "speaker": "p3",
      "text": "회의록은 오늘 오후에 공유드릴게요.",
      "uncertain": false
    },
    {
      "segment_id": "seg_15",
      "start_ms": 230000,
      "end_ms": 242000,
      "speaker": "p4",
      "text": "혜연 작가가 큐시트 초안도 금요일까지 부탁해요.",
      "uncertain": false
    },
    {
      "segment_id": "seg_16",
      "start_ms": 242000,
      "end_ms": 247000,
      "speaker": "p3",
      "text": "네, 금요일까지 드릴게요.",
      "uncertain": false
    }
  ],

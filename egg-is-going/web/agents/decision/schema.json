{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "decision agent output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decisions",
    "action_items",
    "questions_for_human"
  ],
  "properties": {
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "item_key",
          "title",
          "status",
          "value",
          "hold_reason",
          "revisit",
          "evidence",
          "confidence"
        ],
        "properties": {
          "item_key": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "proposed",
              "confirmed",
              "on_hold",
              "dropped"
            ]
          },
          "value": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "hold_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "revisit": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "segment_id"
              ],
              "properties": {
                "segment_id": {
                  "type": "string"
                }
              }
            }
          },
          "confidence": {
            "type": "number"
          }
        }
      }
    },
    "action_items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action_key",
          "description",
          "assignee",
          "due_at",
          "evidence"
        ],
        "properties": {
          "action_key": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "assignee": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "due_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "segment_id"
              ],
              "properties": {
                "segment_id": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "questions_for_human": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "target",
          "kind",
          "question",
          "evidence"
        ],
        "properties": {
          "target": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "item_status",
              "action_due",
              "action_assignee",
              "other"
            ]
          },
          "question": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "segment_id"
              ],
              "properties": {
                "segment_id": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}

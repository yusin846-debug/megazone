# SQLite 파일 (나중에 Postgres로 바꿀 때 prisma/schema.prisma 의 provider도 함께 변경)
DATABASE_URL="file:./dev.db"

# 에이전트 실행 방식: mock(규칙 기반 기준선, 키 불필요) | anthropic(Claude API)
AGENT_PROVIDER="mock"
ANTHROPIC_API_KEY=""
AGENT_MODEL="claude-opus-5-5"
AGENT_EFFORT="medium"

# 검증 실패 시 단계당 자동 재처리 한도 (02_Swimlane_ToBe: 초기 2회 제안)
MAX_AUTO_RETRY=2

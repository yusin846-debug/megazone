# Vercel Marketplace에서 연결한 전용 PostgreSQL (키 값은 커밋하지 않음)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/egg_is_going?sslmode=require"

# 에이전트 실행 방식: mock(규칙 기반 기준선, 키 불필요) | anthropic(Claude API)
AGENT_PROVIDER="mock"
ANTHROPIC_API_KEY=""
AGENT_MODEL="claude-opus-5-5"
AGENT_EFFORT="medium"

# 검증 실패 시 단계당 자동 재처리 한도 (02_Swimlane_ToBe: 초기 2회 제안)
MAX_AUTO_RETRY=2

# Authentication: generate a private random value (at least 32 characters).
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
# Public fictional test accounts only. Keep false for employee environments.
EGG_DEMO_LOGIN="false"
# Google Workspace SSO (only registered accounts, restricted to this domain).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_WORKSPACE_DOMAIN=""

{
  "name": "egg-is-going-web",
  "version": "0.1.0",
  "private": true,
  "description": "egg is going 제작회의 워크스페이스 (가상 제작사 교육 프로젝트)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:seed": "node --import tsx prisma/seed.ts",
    "poc:seed": "node --import tsx scripts/seed-poc.ts",
    "poc:test": "node --import tsx --test scripts/poc.test.ts scripts/program-selection.test.ts scripts/chatbot.test.ts",
    "db:reset": "prisma db push --force-reset && tsx prisma/seed.ts",
    "setup": "node scripts/sync-tokens.mjs && prisma migrate deploy && node --import tsx prisma/seed.ts && npm run auth:seed",
    "sync:tokens": "node scripts/sync-tokens.mjs",
    "agent:examples": "tsx scripts/make-examples.ts",
    "agent:test": "tsx scripts/agent-test.ts",
    "run:fixture": "tsx scripts/run-fixture.ts",
    "postinstall": "prisma generate",
    "vercel-build": "prisma generate && next build",
    "db:migrate": "prisma migrate deploy",
    "auth:seed": "node --import tsx scripts/seed-auth.ts",
    "auth:test": "node --import tsx --test scripts/auth.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.131.0",
    "@prisma/client": "6.19.3",
    "ajv": "8.17.1",
    "better-auth": "1.7.12",
    "docx": "9.5.1",
    "next": "15.5.27",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "prisma": "6.19.3",
    "tsx": "4.20.5",
    "typescript": "5.9.3"
  }
}

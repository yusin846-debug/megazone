{
  "name": "egg-is-going-web",
  "version": "0.1.0",
  "private": true,
  "description": "egg is going 제작회의 워크스페이스 (가상 제작사 교육 프로젝트)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma db push --force-reset && tsx prisma/seed.ts",
    "setup": "cp -n .env.example .env; node scripts/sync-tokens.mjs && prisma db push && tsx prisma/seed.ts",
    "sync:tokens": "node scripts/sync-tokens.mjs",
    "agent:examples": "tsx scripts/make-examples.ts",
    "agent:test": "tsx scripts/agent-test.ts",
    "run:fixture": "tsx scripts/run-fixture.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.131.0",
    "@prisma/client": "6.19.3",
    "ajv": "8.17.1",
    "docx": "9.5.1",
    "next": "15.5.27",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "prisma": "6.19.3",
    "tsx": "4.20.5",
    "typescript": "5.9.3"
  }
}
